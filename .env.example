# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# External AI data processing is disabled unless a workspace operator explicitly enables it.
AI_EXTERNAL_PROCESSING_ENABLED="false"

# Razorpay Subscriptions. Keep all three values on the server; the webhook
# secret is configured separately in the Razorpay Dashboard webhook settings.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Transactional account email via Resend. Verify the sender domain with Resend.
# PUBLIC_APP_URL must be the public HTTPS origin in production so emailed links work.
RESEND_API_KEY=""
EMAIL_FROM="TalentEdge <accounts@example.com>"
PUBLIC_APP_URL=""

# Required for one-time first college administrator setup in a local database.
# Generate a unique random value and keep it private. The setup route disables
# itself after the first password-backed account has been created.
AUTH_BOOTSTRAP_TOKEN="replace-with-a-long-random-one-time-setup-secret"

# Required to encrypt platform-administrator authenticator secrets at rest.
# Use a private random key of at least 32 characters and keep a secure backup.
PLATFORM_MFA_ENCRYPTION_KEY="replace-with-a-private-random-key-of-at-least-32-characters"

# Local server binding. Keep the default loopback-only for local development.
HOST="127.0.0.1"
PORT="3000"

# MySQL connection used by the local server and migration/seeder scripts.
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="talentedge"
# Optional location for `npm run db:backup`; use a restricted encrypted volume in production.
DB_BACKUP_DIR="backups"
# Optional absolute path when mysqldump is not available on PATH.
MYSQLDUMP_PATH=""

# Optional isolated code execution service (self-host Judge0 CE separately).
# Keep this server-side only; never expose the endpoint token to browser code.
# Set auth token/user only if the Judge0 deployment requires those headers.
JUDGE0_URL="http://localhost:2358"
JUDGE0_AUTH_TOKEN=""
JUDGE0_AUTH_USER=""
# Per submission resource ceilings. The server also disables network access.
JUDGE0_CPU_LIMIT="2"
JUDGE0_WALL_LIMIT="5"
JUDGE0_MEMORY_LIMIT_KB="128000"

# Keep disabled by default. Set true only for a private local environment
# where you want to test self-service creation of additional college tenants.
ALLOW_WORKSPACE_REGISTRATION="false"


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
