# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required for one-time first college administrator setup in a local database.
# Generate a unique random value and keep it private. The setup route disables
# itself after the first password-backed account has been created.
AUTH_BOOTSTRAP_TOKEN="replace-with-a-long-random-one-time-setup-secret"

# Local server binding. Keep the default loopback-only for local development.
HOST="127.0.0.1"
PORT="3000"

# MySQL connection used by the local server and migration/seeder scripts.
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="talentedge"

# Keep disabled by default. Set true only for a private local environment
# where you want to test self-service creation of additional college tenants.
ALLOW_WORKSPACE_REGISTRATION="false"


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
